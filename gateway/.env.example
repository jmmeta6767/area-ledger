# Local development only. Copy to .dev.vars and never commit real values.
ALLOWED_ORIGINS=https://localhost.invalid
OCR_UPSTREAM_URL=https://provider.example.invalid/ocr
OCR_API_KEY=replace-locally

# Optional Google Workspace integration (OAuth 2.0)
GOOGLE_CLIENT_ID=replace-locally.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-locally
# Random secret, at least 24 characters. Used only to encrypt Google refresh tokens in D1.
GOOGLE_TOKEN_KEY=replace-with-long-random-secret
